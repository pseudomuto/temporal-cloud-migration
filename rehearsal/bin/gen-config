#!/usr/bin/env bash
#
# Write the configs for Temporal Proxy and both s2s-proxies into generated/,
# shaped like the playbook's live config blocks, with local addresses in place
# of Temporal Cloud's and testing:// keys in place of KMS.
#
# Rerun it whenever the playbook changes one of those blocks: after switching to
# strict, and after each handoff. Then restart whatever reads the file.
#
# Environment, each remembered in generated/settings and reused when unset, so
# a handoff doesn't quietly undo an earlier switch to strict:
#   ACCT        Cloud account suffix (default: acct), so ns1 is ns1.acct there
#   NAMESPACES  Namespaces to migrate (default: "ns1 ns2 ns3")
#   BINDING     encryption.namespaceBinding for both proxies (default: permissive)
#   HANDED_OFF  Namespaces whose routing rule is removed (default: none); set it
#               to "" to put every rule back
#   ALLOW_OPAQUE_PLAINTEXT  s2s-proxy's allowOpaquePlaintext (default: false)
#
# Keys are generated once into generated/keys and reused, so payloads sealed
# earlier keep opening. Delete that file only along with the clusters' data.
set -euo pipefail

cd "$(dirname "$0")/.."

mkdir -p generated
settings=generated/settings
if [[ -f $settings ]]; then
  # shellcheck source=/dev/null
  . "$settings"
fi

acct=${ACCT:-${saved_acct:-acct}}
namespaces=${NAMESPACES:-${saved_namespaces:-ns1 ns2 ns3}}
binding=${BINDING:-${saved_binding:-permissive}}
handed_off=${HANDED_OFF-${saved_handed_off:-}}
allow_opaque=${ALLOW_OPAQUE_PLAINTEXT:-${saved_allow_opaque:-false}}

case $binding in
  off | permissive | strict) ;;
  *)
    echo "BINDING must be off, permissive, or strict, got '$binding'" >&2
    exit 1
    ;;
esac

for ns in $handed_off; do
  if [[ " $namespaces " != *" $ns "* ]]; then
    echo "HANDED_OFF names '$ns', which isn't in NAMESPACES ($namespaces)" >&2
    exit 1
  fi
done

keys=generated/keys
touch "$keys"

# key NAME prints the testing:// URI for NAME, generating it on first use. Each
# name gets its own key: both proxies refuse to start on a duplicate key id.
key() {
  local uri
  uri=$(awk -v n="$1" '$1 == n { print $2 }' "$keys")
  if [[ -z $uri ]]; then
    uri="testing://$(openssl rand -base64 32 | tr '+/' '-_')"
    echo "$1 $uri" >>"$keys"
  fi
  echo "$uri"
}

k_proxy=$(key proxy)
k_repl=$(key repl)

# overrides PAD prints the per-Namespace key map, identical in both proxies.
overrides() {
  local p ns
  p=$(printf '%*s' "$1" '')
  echo "${p}# One key per Namespace, keyed by local name. Must be identical in both proxies."
  echo "${p}overrides:"
  for ns in $namespaces; do
    echo "${p}  $ns:"
    echo "${p}    uri: $(key "ns:$ns")"
    echo "${p}    duration: 24h"
    echo "${p}    renewBefore: 1h"
  done
}

rules() {
  local ns pinned=""
  for ns in $namespaces; do
    [[ " $handed_off " == *" $ns "* ]] || pinned="$pinned $ns"
  done
  if [[ -z $pinned ]]; then
    echo "  rules: [] # every Namespace is handed off; see Phase 4"
    return
  fi
  echo "  rules:"
  for ns in $pinned; do
    echo "    - { <<: *self-hosted, match: { namespace: $ns } }"
  done
}

cat >generated/temporal-proxy.yaml <<EOF
# Generated by bin/gen-config: ACCT=$acct NAMESPACES="$namespaces" BINDING=$binding HANDED_OFF="$handed_off"
# Not on a loopback address, so the Web UI container can reach it.
hostPort: 0.0.0.0:7233

# Not a config key; Temporal Proxy ignores it. It only holds the anchor the
# rules below merge in.
x-self-hosted: &self-hosted
  upstream: self-hosted

routing:
  default: cloud
  system: self-hosted
  # One rule per Namespace still on the self-hosted side. Delete a line at its
  # handoff; an empty list is the end state.
$(rules)

upstreams:
  - name: self-hosted
    hostPort: localhost:17233
    insecure: true
    namespaces:
      # Label payloads ${namespaces%% *}.$acct, the name they keep after handoff.
      bindingLabelsFrom: cloud

  # Stands in for {{ .RemoteNamespace }}.tmprl.cloud:7233, with no TLS or API key.
  - name: cloud
    hostPort: localhost:27233
    insecure: true
    namespaces:
      rules:
        suffix: .$acct

encryption:
  enabled: true
  failures: true
  namespaceBinding: $binding
  default:
    uri: $k_proxy # K_proxy
    decryptURIs:
      - $k_repl # K_repl
    duration: 24h
    renewBefore: 1h
$(overrides 2)

# The codec server, for the Web UI pointed straight at the cloud Temporal
# Service. Loopback, so it needs no auth or TLS.
http:
  hostPort: 127.0.0.1:8445
  insecure: true
  codecServer:
    enabled: true
    cors:
      origins:
        - http://localhost:8081

metrics:
  hostPort: 127.0.0.1:9090
  labels:
    namespace: true
EOF

mappings() {
  local ns
  for ns in $namespaces; do
    echo "        - { local: $ns, remote: $ns.$acct }"
  done
}

cat >generated/s2s-self-hosted.yaml <<EOF
# Generated by bin/gen-config: ACCT=$acct NAMESPACES="$namespaces" BINDING=$binding
# The playbook's s2s-proxy, next to the self-hosted Temporal Service.
clusterConnections:
  - name: cloud
    local:
      connectionType: tcp
      tcpClient:
        address: temporal-self-hosted:7233
      # The self-hosted Temporal Service reaches cloud here.
      tcpServer:
        address: 0.0.0.0:6233
    remote:
      connectionType: mux-client
      muxCount: 1
      muxAddressInfo:
        address: s2s-cloud:6334
    # One mapping per migrating Namespace. The remote name is the binding label,
    # so it must be exactly what Temporal Proxy's suffix rule produces.
    namespaceTranslation:
      mappings:
$(mappings)
    encryption:
      enabled: true
      failures: true
      namespaceBinding: $binding
      # Also seals replication: with no replication policy, admin traffic falls
      # back to default. Naming K_repl under both would be a duplicate key.
      default:
        uri: $k_repl # K_repl
        decryptURIs:
          - $k_proxy # K_proxy
        duration: 24h
        renewBefore: 1h
$(overrides 6)
      allowOpaquePlaintext: $allow_opaque

profiling:
  pprofAddress: 0.0.0.0:6060
metrics:
  prometheus:
    listenAddress: 0.0.0.0:9091
EOF

cat >generated/s2s-cloud.yaml <<EOF
# Generated by bin/gen-config.
# Stands in for the s2s-proxy Temporal Cloud runs. It holds no keys and passes
# sealed payloads through untouched.
clusterConnections:
  - name: self-hosted
    local:
      connectionType: tcp
      tcpClient:
        address: temporal-cloud:7233
      # The cloud Temporal Service reaches self-hosted here.
      tcpServer:
        address: 0.0.0.0:6333
    remote:
      connectionType: mux-server
      muxCount: 1
      muxAddressInfo:
        address: 0.0.0.0:6334

profiling:
  pprofAddress: 0.0.0.0:6060
metrics:
  prometheus:
    listenAddress: 0.0.0.0:9091
EOF

cat >"$settings" <<EOF
saved_acct="$acct"
saved_namespaces="$namespaces"
saved_binding="$binding"
saved_handed_off="$handed_off"
saved_allow_opaque="$allow_opaque"
EOF

echo "Wrote generated/{temporal-proxy,s2s-self-hosted,s2s-cloud}.yaml (binding: $binding, handed off: ${handed_off:-none})"
