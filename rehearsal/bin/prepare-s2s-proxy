#!/usr/bin/env bash
#
# Check out the s2s-proxy source the playbook assumes into .work/s2s-proxy, for
# docker compose to build.
#
# The playbook needs temporalio/s2s-proxy#322 to #326, which are stacked with
# #326 (admin-seal-errors) on top, and temporal-proxy v1.0.0 (#327). The stack
# was cut before #327 merged, so it still builds on temporal-proxy v0.10.0, and
# this merges main into it to get both. Once the stack merges, set
# S2S_PROXY_STACK=main.
#
# Environment:
#   S2S_PROXY_REPO   where to clone from (default: GitHub)
#   S2S_PROXY_STACK  branch to build (default: admin-seal-errors)
#   S2S_PROXY_BASE   branch merged into it (default: main)
set -euo pipefail

cd "$(dirname "$0")/.."

src=.work/s2s-proxy
repo=${S2S_PROXY_REPO:-https://github.com/temporalio/s2s-proxy.git}
stack=${S2S_PROXY_STACK:-admin-seal-errors}
base=${S2S_PROXY_BASE:-main}

if [[ ! -d $src/.git ]]; then
  mkdir -p .work
  git clone --quiet "$repo" "$src"
fi

git -C "$src" fetch --quiet origin "$stack" "$base"
git -C "$src" checkout --quiet --detach "origin/$stack"

if [[ $stack != "$base" ]]; then
  # A conflict stops here with git's own message; resolve it in $src, or wait
  # for the stack to be rebased.
  git -C "$src" -c user.name=rehearsal -c user.email=rehearsal@localhost \
    merge --quiet --no-edit "origin/$base"
fi

echo "s2s-proxy: origin/$stack ($(git -C "$src" rev-parse --short "origin/$stack")) + origin/$base ($(git -C "$src" rev-parse --short "origin/$base"))"
grep 'go.temporal.io/proxy ' "$src/go.mod" | sed 's/^[[:space:]]*/temporal-proxy: /'
